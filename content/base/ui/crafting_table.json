{
  "version": 1,
  "root": {
    "id": "crafting_table_root",
    "layout": {
      "anchor": [
        "center",
        "center"
      ],
      "size": [
        420,
        300
      ]
    },
    "kind": "panel",
    "style": "",
    "children": [
      {
        "id": "title",
        "layout": {
          "offset": [
            14,
            12
          ],
          "size": [
            340,
            12
          ]
        },
        "kind": "label",
        "style": "heading",
        "text": "WORKBENCH"
      },
      {
        "id": "table",
        "layout": {
          "offset": [
            24,
            36
          ],
          "size": [
            110,
            110
          ]
        },
        "kind": "slot_grid",
        "style": "grid",
        "binding": {
          "source": "table",
          "index": 0
        },
        "count": "table_slots",
        "columns": "table_side",
        "rows": "table_side",
        "offset": 0
      },
      {
        "id": "table_result",
        "layout": {
          "offset": [
            70,
            168
          ],
          "size": [
            30,
            30
          ]
        },
        "kind": "slot",
        "style": "slot",
        "binding": {
          "source": "table_result"
        }
      },
      {
        "id": "storage_label",
        "layout": {
          "offset": [
            170,
            122
          ],
          "size": [
            100,
            10
          ]
        },
        "kind": "label",
        "style": "heading",
        "text": "STORAGE"
      },
      {
        "id": "storage",
        "layout": {
          "offset": [
            170,
            136
          ],
          "size": [
            234,
            66
          ]
        },
        "kind": "slot_grid",
        "style": "grid",
        "binding": {
          "source": "player",
          "index": 0
        },
        "count": "storage_slots",
        "columns": 9,
        "rows": 3,
        "offset": "hotbar_slots",
        "page": "storage_page"
      },
      {
        "id": "storage_prev",
        "layout": {
          "offset": [
            348,
            119
          ],
          "size": [
            24,
            14
          ]
        },
        "kind": "button",
        "style": "button",
        "text": "<",
        "action": {
          "type": "increment",
          "key": "storage_page",
          "amount": -1
        }
      },
      {
        "id": "storage_next",
        "layout": {
          "offset": [
            378,
            119
          ],
          "size": [
            24,
            14
          ]
        },
        "kind": "button",
        "style": "button",
        "text": ">",
        "action": {
          "type": "increment",
          "key": "storage_page",
          "amount": 1
        }
      },
      {
        "id": "storage_page_label",
        "layout": {
          "offset": [
            260,
            122
          ],
          "size": [
            86,
            10
          ]
        },
        "kind": "label",
        "style": "heading",
        "text": "{storage_page}/{storage_pages}"
      },
      {
        "id": "hotbar_label",
        "layout": {
          "offset": [
            170,
            209
          ],
          "size": [
            150,
            10
          ]
        },
        "kind": "label",
        "style": "heading",
        "text": "QUICK ACCESS"
      },
      {
        "id": "hotbar",
        "layout": {
          "offset": [
            170,
            222
          ],
          "size": [
            234,
            22
          ]
        },
        "kind": "slot_grid",
        "style": "grid",
        "binding": {
          "source": "player",
          "index": 0
        },
        "count": "hotbar_slots",
        "columns": "hotbar_slots",
        "rows": 1,
        "offset": 0
      }
    ]
  }
}
