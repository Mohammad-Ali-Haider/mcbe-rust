@vertex fn vs_entity_shadow(@location(0) position:vec3<f32>,@location(1) uv:vec2<f32>,@location(2) layer:u32,@location(5) m0:vec4<f32>,@location(6) m1:vec4<f32>,@location(7) m2:vec4<f32>,@location(8) m3:vec4<f32>,@location(9) metadata:vec4<u32>)->ShadowVertex{var o:ShadowVertex;o.position=frame.light*mat4x4(m0,m1,m2,m3)*vec4(position,1.);o.uv=uv;o.layer=metadata.x+layer;return o;}
