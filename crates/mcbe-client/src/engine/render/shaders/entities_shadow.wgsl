@vertex fn vs_entity_shadow(@location(0) position:vec3<f32>,@location(1) uv:vec2<f32>,@location(2) layer:u32,@location(5) m0:vec4<f32>,@location(6) m1:vec4<f32>,@location(7) m2:vec4<f32>,@location(8) m3:vec4<f32>,@location(9) metadata:vec4<u32>,@location(10) uv0:vec4<f32>,@location(11) uv1:vec4<f32>,@location(12) uv2:vec4<f32>,@location(13) uv3:vec4<f32>,@location(14) uv4:vec4<f32>,@location(15) uv5:vec4<f32>)->ShadowVertex{var o:ShadowVertex;o.position=frame.light*mat4x4(m0,m1,m2,m3)*vec4(position,1.);let rect=array<vec4<f32>,6>(uv0,uv1,uv2,uv3,uv4,uv5)[layer%6u];o.uv=rect.xy+uv*rect.zw;let skin=metadata.y>>8u;o.layer=select(metadata.x+layer,(skin-1u)|0x21000000u,skin>0u);return o;}
