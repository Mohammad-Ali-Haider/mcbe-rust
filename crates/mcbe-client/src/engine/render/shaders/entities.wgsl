@vertex fn vs_entity(@location(0) position:vec3<f32>,@location(1) uv:vec2<f32>,@location(2) layer:u32,@location(3) shade:f32,@location(4) bary:vec3<f32>,@location(5) m0:vec4<f32>,@location(6) m1:vec4<f32>,@location(7) m2:vec4<f32>,@location(8) m3:vec4<f32>,@location(9) metadata:vec4<u32>,@location(10) uv0:vec4<f32>,@location(11) uv1:vec4<f32>,@location(12) uv2:vec4<f32>,@location(13) uv3:vec4<f32>,@location(14) uv4:vec4<f32>,@location(15) uv5:vec4<f32>)->Out {
 let model=mat4x4(m0,m1,m2,m3);let world=(model*vec4(position,1.)).xyz;var o:Out;o.position=camera.matrix*vec4(world,1.);o.world=world;o.relative=world-camera.eye.xyz;let rect=array<vec4<f32>,6>(uv0,uv1,uv2,uv3,uv4,uv5)[layer%6u];o.uv=rect.xy+uv*rect.zw;o.skin=metadata.y>>8u;o.layer=(metadata.x+layer)|0x80000000u|select(0u,0x20000000u,o.skin>0u);o.bary=bary;o.entity=1u;
 let normals=array<vec3<f32>,6>(vec3(0.,1.,0.),vec3(0.,-1.,0.),vec3(0.,0.,-1.),vec3(0.,0.,1.),vec3(1.,0.,0.),vec3(-1.,0.,0.));let normal_matrix=mat3x3(cross(m1.xyz,m2.xyz),cross(m2.xyz,m0.xyz),cross(m0.xyz,m1.xyz));let normal=normalize(normal_matrix*normals[layer%6u]);o.shade=0.5+0.5*max(dot(normal,normalize(vec3(-0.4,0.8,-0.25))),0.);
 o.tint=select(select(vec3(1.),vec3(0.8,1.,0.85),(metadata.y&2u)!=0u),vec3(1.,0.35,0.35),(metadata.y&1u)!=0u);return o;
}
