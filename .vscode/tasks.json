{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Play (release)",
      "type": "process",
      "command": "cargo",
      "args": [
        "run",
        "--release"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$rustc"
      ]
    },
    {
      "label": "New world (release)",
      "type": "process",
      "command": "cargo",
      "args": [
        "new-world"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$rustc"
      ]
    },
    {
      "label": "Build (release)",
      "type": "process",
      "command": "cargo",
      "args": [
        "build",
        "--release",
        "--locked"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$rustc"
      ]
    },
    {
      "label": "Test workspace",
      "type": "process",
      "command": "cargo",
      "args": [
        "test",
        "--workspace",
        "--locked"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$rustc"
      ]
    },
    {
      "label": "Clippy",
      "type": "process",
      "command": "cargo",
      "args": [
        "clippy",
        "--workspace",
        "--all-targets",
        "--locked",
        "--",
        "-D",
        "warnings"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$rustc"
      ]
    }
  ]
}
